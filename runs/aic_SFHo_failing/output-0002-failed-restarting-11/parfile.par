# <trackers_extrema>  # =========================================================
# # control trackers based on field extrema

# filename = tra.ext

# N_tracker = 1
# filename = tra.ext

# control_field = Z4c.chi

# ini_1_x1 = 0               # initial offset
# ini_1_x2 = 0
# ini_1_x3 = 0
# minima_1 = true              # for update_strategy = 1
# ref_level_1 = 1
# ref_type_1 = 1              # 0: to the point, 1: sph. region
